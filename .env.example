DB_USER=postgres
DB_PASSWORD=secure_password_here
JWT_SECRET=your_very_secure_jwt_secret_key_minimum_32_chars
SERVICE_KEY=internal_service_security_key
DOMAIN_NAME=example.com

# --- backend-python (microservicio FastAPI + LangGraph) ---
# Clave que el backend .NET envía en el header X-API-Key para consumir este servicio
PYTHON_SERVICE_API_KEY=your_python_service_api_key_here
# API key de Groq para generar el resumen narrativo (free tier, sin tarjeta)
# Obtener en: console.groq.com
GROQ_API_KEY=your_groq_api_key_here